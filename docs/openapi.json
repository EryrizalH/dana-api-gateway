              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getApiHealth",
        "summary": "Health proses gateway",
        "security": [],
        "responses": {
          "200": {
            "description": "Proses HTTP merespons; tanpa wrapper success/data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/qr/{id}": {
      "get": {
        "tags": [
          "Checkout"
        ],
        "operationId": "getCheckout",
        "summary": "Halaman kasir atau redirect gambar QR",
        "description": "Lookup memperbarui semua transaksi PENDING yang melewati expires_at menjadi EXPIRED. Route ini juga dapat memulai dispatcher callback expiry secara asinkron untuk transaksi terkait; dispatcher dapat memproses transaksi expired lain. GET ini mempunyai efek samping. Secara default menghasilkan HTML kasir dengan polling status setiap 3 detik. mode format=raw atau raw=1 merespons 302 ke QRServer (api.qrserver.com), bukan PNG atau QR payload mentah dari gateway. Redirect meneruskan qris_code ke layanan tersebut. Raw bagi EXPIRED menghasilkan 410; HTML bagi EXPIRED tetap 200.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "qris_id atau trx_id. Lookup mencoba kedua jenis ID.",
            "schema": {
              "type": "string"
            },
            "example": "fixture1"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "raw"
              ]
            },
            "description": "Pilih redirect gambar QR. Hilangkan untuk HTML kasir."
          },
          {
            "name": "raw",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Alias format=raw."
          }
        ],
        "responses": {
          "200": {
            "description": "HTML kasir untuk transaksi PENDING/PAID/EXPIRED.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "302": {
            "description": "Mode raw: redirect ke endpoint gambar QRServer.",
            "headers": {
              "Location": {
                "description": "URL QRServer dengan qris_code dalam query data.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "ID tidak ditemukan.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "410": {
            "description": "Mode raw bagi EXPIRED: teks QRIS Kedaluwarsa.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    }
  },
  "webhooks": {
    "paymentCallback": {
      "post": {
        "tags": [
          "Consumer callbacks"
        ],
        "operationId": "receivePaymentCallback",
        "summary": "Callback outbound dari gateway ke aplikasi konsumen",
        "description": "Gateway POST ke PAYMENT_WEBHOOK_URL dengan x-webhook-secret dari PAYMENT_WEBHOOK_SECRET. Hanya transaksi dengan reference_id yang dapat memicu callback; URL dan secret juga harus dikonfigurasi. HTTP 2xx dianggap delivered, sedangkan 400/404/422 langsung rejected. Respons lainnya, error jaringan, atau timeout dicoba maksimal 3 attempt per dispatch, dengan timeout 5 detik per attempt dan jeda 100 ms. Status PAID lokal tetap PAID saat callback gagal. Paid tidak memiliki antrean retry durable setelah dispatch selesai. Expiry diproses saat startup CLI, setiap 60 detik, dan melalui beberapa GET. expiry_webhook_sent=1 juga ditulis untuk rejected/failed/skipped, sehingga flag ini bukan bukti penerimaan HTTP 2xx. Callback tidak menyediakan event ID unik, timestamp tanda tangan, maupun HMAC; secret header adalah shared secret. Konsumen harus memverifikasi secret, mencocokkan reference_id dan amount ke pesanan sendiri, serta memproses perubahan status secara idempoten berdasarkan transaksi dan event. Body respons konsumen diabaikan gateway. Timeout dapat terjadi setelah konsumen sudah memproses payload.",
        "security": [
          {
            "CallbackSecret": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCallback"
              },
              "examples": {
                "paid": {
                  "summary": "Fixture payment.paid",
                  "value": {
                    "event": "payment.paid",
                    "reference_id": "ORDER-FIXTURE-001",
                    "qris_id": "fixture1",
                    "trx_id": "TRX-FIXTURE1",
                    "amount": 25000,
                    "status": "paid",
                    "paid_at": "2026-10-06T03:01:00.000Z",
                    "payment_details": {
                      "amount": 25000,
                      "text": "Fixture: menerima Rp 25.000"
                    }
                  }
                },
                "expired": {
                  "summary": "Fixture payment.expired",
                  "value": {
                    "event": "payment.expired",
                    "reference_id": "ORDER-FIXTURE-001",
                    "qris_id": "fixture1",
                    "trx_id": "TRX-FIXTURE1",
                    "amount": 25000,
                    "status": "expired",
                    "expired_at": "2026-10-06T03:05:00.000Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Acknowledgment konsumen; gateway menganggap delivery berhasil dan mengabaikan body."
          },
          "400": {
            "description": "Rejection permanen; tidak diulang dalam dispatch ini."
          },
          "404": {
            "description": "Rejection permanen; tidak diulang dalam dispatch ini."
          },
          "422": {
            "description": "Rejection permanen; tidak diulang dalam dispatch ini."
          },
          "default": {
            "description": "Status lainnya memicu retry hingga tiga attempt per dispatch. Error jaringan/timeout mengikuti kebijakan yang sama."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "GatewayApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key inbound dari environment API_KEY. Backend juga menerima api_key/apikey dalam query, tetapi integrasi baru harus memakai header; query URL muncul dalam log auth gagal. Tidak sama dengan secret callback."
      },
      "CallbackSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-webhook-secret",
        "description": "Secret outbound dari PAYMENT_WEBHOOK_SECRET, dibandingkan oleh aplikasi penerima. Ini shared secret header, tanpa HMAC/signature. Jangan memakai API_KEY inbound sebagai asumsi secret ini."
      }
    },
    "schemas": {
      "PaymentStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PAID",
          "EXPIRED"
        ],
        "description": "Status API memakai huruf besar; status callback memakai huruf kecil."
      },
      "RecommendedAmount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "Profil input integrasi yang dianjurkan: integer positif dalam rentang safe integer JavaScript. Ini bukan validasi ketat backend saat ini: /create-qris memakai isNaN dan parseInt(amount, 10), sehingga numeric string dan beberapa nilai pecahan/scientific dapat diterima atau dikoersi. SDK menggunakan profil integer ini untuk menghindari perubahan nominal tanpa sengaja.",
        "examples": [
          25000
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "description": "Dapat muncul pada kegagalan parsing JSON."
          },
          "received": {
            "type": "object",
            "properties": {
              "body": {},
              "query": {
                "type": "object",
                "additionalProperties": true
              },
              "extracted_text": {}
            },
            "required": [
              "body",
              "query",
              "extracted_text"
            ]
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "PublicStatusNotFound": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "status": {
            "type": "string",
            "const": "NOT_FOUND"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "status",
          "message"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "OK"
          },
          "service": {
            "type": "string",
            "const": "QRIS Dynamic Gateway"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ],
        "description": "Tidak memakai success atau data. Endpoint ini tidak menguji provider pembayaran, Android, QR scanner, atau penerimaan callback."
      },
      "CreateQrisRequest": {
