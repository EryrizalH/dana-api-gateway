{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "DANA API Gateway Integration Contract",
    "version": "0.1.0",
    "description": "Kontrak source lokal pada 6 Oktober 2026 (server.js/db.js), bukan bukti deployment atau integrasi produksi. Gateway Node/Express/SQLite mengubah template QRIS statis menjadi dinamis, mencocokkan nominal notifikasi HP, dan mengirim callback. Gateway bukan API pembayaran resmi DANA dan tidak memverifikasi settlement kepada provider. Dokumen memilih metode integrasi yang dianjurkan; app.all pada create/notifications/check juga menerima metode lain yang tidak diperluas di sini. Amount request dibatasi ke profil integer positif safe integer untuk integrasi; validasi backend saat ini masih coercive. Admin login/dashboard berada di luar kontrak SDK ini."
  },
  "servers": [
    {
      "url": "https://gateway.example.invalid",
      "description": "Placeholder. Ganti dengan URL gateway milik Anda; host ini bukan deployment yang diverifikasi."
    }
  ],
  "tags": [
    {
      "name": "Transactions"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Health"
    },
    {
      "name": "Checkout"
    },
    {
      "name": "Consumer callbacks"
    }
  ],
  "paths": {
    "/create-qris": {
      "post": {
        "tags": [
          "Transactions"
        ],
        "operationId": "createQris",
        "summary": "Buat transaksi QRIS dinamis dengan expiry lima menit",
        "description": "Menyimpan transaksi PENDING baru setiap request. reference_id tidak unik dan pengiriman ulang create tidak idempoten; jangan retry otomatis saat timeout karena hasil pembuatan dapat sudah tersimpan. Backend memakai app.all dan menerima body/query termasuk GET, tetapi profil integrasi ini memakai POST JSON. Gunakan nominal integer positif safe integer walaupun backend masih coercive dengan parseInt. Template memakai qris_static body, lalu query, lalu QRIS_STATIC. Callback URL/secret tidak dapat diset per request; keduanya konfigurasi global server.",
        "security": [
          {
            "GatewayApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQrisRequest"
              },
              "example": {
                "amount": 25000,
                "reference_id": "ORDER-FIXTURE-001"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CreateQrisRequest"
              },
              "example": {
                "amount": 25000,
                "reference_id": "ORDER-FIXTURE-001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaksi baru dengan data QRIS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateQrisResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Template tidak tersedia/gagal menghasilkan QRIS (JSON), atau exception backend tidak tertangani (HTML).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/notifications": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "submitNotification",
        "summary": "Terima notifikasi pembayaran Android",
        "description": "Input dari Android/MacroDroid/Tasker; alias /webhook/dana adalah inbound gateway, berbeda dari callback outbound ke konsumen. Matching berdasarkan nominal yang sama ke PENDING tertua (ORDER BY created_at ASC) yang belum expired. Tidak ada deduplikasi notification ID maupun verifikasi pembayar/provider. Mengirim ulang notifikasi dapat melunasi transaksi pending lain dengan nominal sama. Handler menunggu hasil dispatch callback, hingga sekitar 15,2 detik untuk tiga timeout, sebelum merespons matched=true. Callback gagal tetap menghasilkan PAID dan HTTP 200. HTTP 200 matched=false berarti dicatat tanpa mencocokkan transaksi. Semua metode diterima oleh app.all; dokumen ini memilih POST sebagai profil integrasi. Payload query juga dikenali oleh backend; gunakan body agar teks/kredensial tidak tersebar dalam URL/log. Jika amount tidak ditemukan, backend dapat menyertakan body/query pada respons error; jangan menaruh secret tambahan di payload.",
        "security": [
          {
            "GatewayApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRequest"
              },
              "examples": {
                "structured": {
                  "summary": "Fixture nominal langsung",
                  "value": {
                    "amount": 25000,
                    "text": "Fixture: menerima Rp 25.000"
                  }
                },
                "text": {
                  "summary": "Fixture parsing teks",
                  "value": {
                    "text": "Fixture: menerima Rp 25.000"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRequest"
              },
              "example": {
                "text": "Fixture: menerima Rp 25.000"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notifikasi dicatat; periksa matched dan, bila cocok, data.callback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/webhook/dana": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "submitDanaWebhook",
        "summary": "Terima notifikasi pembayaran Android",
        "description": "Input dari Android/MacroDroid/Tasker; alias /webhook/dana adalah inbound gateway, berbeda dari callback outbound ke konsumen. Matching berdasarkan nominal yang sama ke PENDING tertua (ORDER BY created_at ASC) yang belum expired. Tidak ada deduplikasi notification ID maupun verifikasi pembayar/provider. Mengirim ulang notifikasi dapat melunasi transaksi pending lain dengan nominal sama. Handler menunggu hasil dispatch callback, hingga sekitar 15,2 detik untuk tiga timeout, sebelum merespons matched=true. Callback gagal tetap menghasilkan PAID dan HTTP 200. HTTP 200 matched=false berarti dicatat tanpa mencocokkan transaksi. Semua metode diterima oleh app.all; dokumen ini memilih POST sebagai profil integrasi. Payload query juga dikenali oleh backend; gunakan body agar teks/kredensial tidak tersebar dalam URL/log. Jika amount tidak ditemukan, backend dapat menyertakan body/query pada respons error; jangan menaruh secret tambahan di payload.",
        "security": [
          {
            "GatewayApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRequest"
              },
              "examples": {
                "structured": {
                  "summary": "Fixture nominal langsung",
                  "value": {
                    "amount": 25000,
                    "text": "Fixture: menerima Rp 25.000"
                  }
                },
                "text": {
                  "summary": "Fixture parsing teks",
                  "value": {
                    "text": "Fixture: menerima Rp 25.000"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRequest"
              },
              "example": {
                "text": "Fixture: menerima Rp 25.000"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notifikasi dicatat; periksa matched dan, bila cocok, data.callback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/check-payment": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "operationId": "checkPayment",
        "summary": "Cek pembayaran dengan API key",
        "description": "Lookup memperbarui semua transaksi PENDING yang melewati expires_at menjadi EXPIRED. Route ini juga dapat memulai dispatcher callback expiry secara asinkron untuk transaksi terkait; dispatcher dapat memproses transaksi expired lain. GET ini mempunyai efek samping. Kirim qris_id atau trx_id; salah satu diperlukan untuk lookup walaupun backend mengembalikan 404, bukan 400, jika keduanya kosong. qris_id diprioritaskan bila keduanya diberikan. Nilai setiap parameter juga dicoba sebagai jenis ID lainnya. app.all menerima metode/body lain, tetapi profil integrasi ini menggunakan GET dengan parameter ID dalam query dan API key pada header.",
        "security": [
          {
            "GatewayApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "qris_id",
            "in": "query",
            "description": "ID QRIS, atau nilai trx_id sebagai fallback. Prioritas lebih tinggi dari trx_id.",
            "schema": {
              "type": "string"
            },
            "example": "fixture1"
          },
          {
            "name": "trx_id",
            "in": "query",
            "description": "ID transaksi, atau nilai qris_id sebagai fallback. Dipakai bila qris_id kosong.",
            "schema": {
              "type": "string"
            },
            "example": "TRX-FIXTURE1"
          }
        ],
        "responses": {
          "200": {
            "description": "Status terbungkus pada data; tidak mengandung expires_at/reference_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckPaymentResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/qr-status/{id}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "operationId": "getPublicStatus",
        "summary": "Status publik untuk polling kasir",
        "description": "Lookup memperbarui semua transaksi PENDING yang melewati expires_at menjadi EXPIRED. Route ini juga dapat memulai dispatcher callback expiry secara asinkron untuk transaksi terkait; dispatcher dapat memproses transaksi expired lain. GET ini mempunyai efek samping. Respons sukses adalah flat tanpa data, dan tidak mengandung reference_id. Endpoint publik; kepemilikan ID cukup untuk membaca status/nominal.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "qris_id atau trx_id. Lookup mencoba kedua jenis ID.",
            "schema": {
              "type": "string"
            },
            "example": "fixture1"
          }
        ],
        "responses": {
          "200": {
            "description": "Status pada tingkat atas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "ID tidak ada; status=NOT_FOUND pada tingkat atas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStatusNotFound"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/qr/{id}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "operationId": "getQris",
        "summary": "Detail QRIS publik",
        "description": "Lookup memperbarui seluruh transaksi lewat expiry menjadi EXPIRED, tetapi route ini tidak langsung memanggil dispatcher callback. Hasil mencakup qris_code dan expires_at dalam data; reference_id tidak disertakan. ID yang ada tetap menghasilkan 200 walau EXPIRED. Endpoint publik, sehingga nominal/detail dapat dibaca dengan ID.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "qris_id atau trx_id. Lookup mencoba kedua jenis ID.",
            "schema": {
              "type": "string"
            },
            "example": "fixture1"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail QRIS pada data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QrisDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
